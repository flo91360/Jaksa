# Copier ce fichier en .env.local et remplir avec les valeurs du projet Supabase
# (Supabase > Project Settings > API Keys).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé « publishable » (sb_publishable_...) ou, à défaut, l'ancienne clé « anon ».
# Elle est publique par nature : la sécurité repose sur les règles RLS de la base.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Facultatif : coordonnées affichées sur les pages légales (docs/DEPLOIEMENT.md, étape 10).
# VITE_CONTACT_EMAIL=contact@exemple.fr
# VITE_PUBLISHER_NAME=Nom de la structure
# VITE_PUBLISHER_LEGAL_FORM=micro-entreprise
# VITE_PUBLISHER_ADDRESS=1 rue de l'Exemple, 75000 Paris
# VITE_PUBLISHER_SIRET=000 000 000 00000
# VITE_PUBLISHER_DIRECTOR=Prénom Nom
