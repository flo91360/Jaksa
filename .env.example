# Copier ce fichier en .env.local et remplir avec les valeurs du projet Supabase
# (Supabase > Project Settings > API Keys).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé « publishable » (sb_publishable_...) ou, à défaut, l'ancienne clé « anon ».
# Elle est publique par nature : la sécurité repose sur les règles RLS de la base.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
